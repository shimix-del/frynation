# Keep real credentials outside the public web directory. Never commit them.
DATABASE_URL="mysql://CPANEL_DB_USER:URL_ENCODED_PASSWORD@CPANEL_DB_HOST:3306/mombasam_nanifrys"
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
NODE_ENV="production"
PORT="5000"
TZ="Africa/Nairobi"
CORS_ORIGINS="https://nanifrys.com,https://www.nanifrys.com"
SITE_MODE="cloud"
# Both installations accept sales. Give the paired backends the same private key.
REPLICA_SHOP_ID="nani-frys-main-shop"
REPLICA_SECRET="REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS"
# Shop only: SITE_MODE=shop, PORT=5050, BIND_HOST=127.0.0.1
# REPLICA_CLOUD_URL="https://nanifrys.com/api"
# BACKUP_DIRECTORY="C:/ProgramData/NaniFrys/backups"
# BACKUP_DEFAULTS_FILE="C:/ProgramData/NaniFrys/backup.cnf"
# MYSQLDUMP_PATH="C:/xampp/mysql/bin/mysqldump.exe"
# LOCAL_DATABASE_NAME="mombasam_nanifrys"
